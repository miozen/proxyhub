PORT=3000
PROXYHUB_IMAGE=ghcr.io/vonzhen/proxyhub:dev
NODE_ENV=production
COOKIE_SECURE=false
TRUST_PROXY=false
REGISTRATION_ENABLED=true
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DATABASE_PATH=/app/data/proxyhub.db
SUBSTORE_ORIGIN=http://sub-store:3000
SUBSTORE_UI_ORIGIN=http://sub-store:3001
SUBSTORE_IMAGE=xream/sub-store:2.36.21
AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_HOURS=12
AUTO_UPDATE_ENABLED=false





