#!/bin/sh
set -eu

SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  LINK=$(readlink "$SCRIPT")
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$(dirname -- "$SCRIPT")/$LINK ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
if [ -f "$SCRIPT_DIR/compose.yaml" ]; then
  DEFAULT_DEPLOY_DIR=$SCRIPT_DIR
  INSTALLED_LAYOUT=true
else
  DEFAULT_DEPLOY_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
  INSTALLED_LAYOUT=false
fi

DEPLOY_DIR=${PROXYHUB_DEPLOY_DIR:-$DEFAULT_DEPLOY_DIR}
if [ -n "${PROXYHUB_COMPOSE_FILE:-}" ]; then
  COMPOSE_FILE=$PROXYHUB_COMPOSE_FILE
elif [ -f "$DEPLOY_DIR/compose.yaml" ]; then
  COMPOSE_FILE="$DEPLOY_DIR/compose.yaml"
else
  COMPOSE_FILE="$DEPLOY_DIR/docker-compose.yml"
fi

if [ -n "${PROXYHUB_ENV_FILE:-}" ]; then
  ENV_FILE=$PROXYHUB_ENV_FILE
elif [ "$INSTALLED_LAYOUT" = true ]; then
  ENV_FILE=/etc/proxyhub/proxyhub.env
else
  ENV_FILE="$DEPLOY_DIR/.env"
fi

if [ "$INSTALLED_LAYOUT" = true ]; then
  DATA_DIR=${PROXYHUB_DATA_DIR:-/var/lib/proxyhub}
  LOG_DIR=${PROXYHUB_LOG_DIR:-/var/log/proxyhub}
  STATE_DIR="$DATA_DIR/state"
  BACKUP_DIR="$DATA_DIR/backups"
  DEFAULT_LOCK_DIR=/run/lock/proxyhub.lock
else
  DATA_DIR=${PROXYHUB_DATA_DIR:-$DEPLOY_DIR}
  LOG_DIR=${PROXYHUB_LOG_DIR:-$DEPLOY_DIR}
  STATE_DIR="$DEPLOY_DIR/.proxyhub"
  BACKUP_DIR="$DEPLOY_DIR/backups"
  DEFAULT_LOCK_DIR="$STATE_DIR/lock"
fi
LOCK_DIR=${PROXYHUB_LOCK_DIR:-$DEFAULT_LOCK_DIR}
FULL_BACKUP_DIR="$BACKUP_DIR/full"
COMPONENT_BACKUP_DIR="$BACKUP_DIR/components"
MANAGER_VERSION=0.1.5
ASSET_STAGE=
ASSET_TARGET_REVISION=none
LOCK_HELD=false
OPERATION_FILE=
OPERATION_COMPONENT=
OPERATION_NAME=
OPERATION_STARTED=
OPERATION_SOURCE=
OPERATION_TARGET=
OPERATION_BACKUP=
OPERATION_PHASE=
OPERATION_FAILED_PHASE=none
OPERATION_ASSET_SOURCE=none
OPERATION_ASSET_TARGET=none

die() { echo "proxyhub: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing command: $1"; }
dc() {
  docker compose \
    --project-directory "$DEPLOY_DIR" \
    --env-file "$ENV_FILE" \
    -f "$COMPOSE_FILE" \
    "$@"
}
now() { date -u +%Y%m%dT%H%M%SZ; }
ensure_env() { [ -f "$ENV_FILE" ] || die "missing .env; run: proxyhub install"; }
atomic_write() {
  output=$1 content=$2
  parent=$(dirname "$output")
  mkdir -p "$parent"
  temp="$output.tmp.$$"
  umask 077
  printf '%s\n' "$content" >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$output"
}
lock_path_is_allowed() {
  case "$LOCK_DIR" in
    /run/lock/proxyhub.lock|"$STATE_DIR"/lock) return 0 ;;
    *)
      [ -n "${PROXYHUB_LOCK_DIR:-}" ] &&
        case "$LOCK_DIR" in "$STATE_DIR"/*) return 0 ;; esac
      ;;
  esac
  return 1
}
release_lock() {
  [ "$LOCK_HELD" = true ] || return 0
  if [ -n "$ASSET_STAGE" ]; then
    case "$ASSET_STAGE" in
      "$STATE_DIR"/asset-stage-*) rm -rf "$ASSET_STAGE" ;;
    esac
    ASSET_STAGE=
  fi
  lock_path_is_allowed || return 0
  if [ -L "$LOCK_DIR" ]; then
    LOCK_HELD=false
    return 0
  fi
  rm -f "$LOCK_DIR/pid" "$LOCK_DIR/command" "$LOCK_DIR/started"
  rmdir "$LOCK_DIR" 2>/dev/null || true
  LOCK_HELD=false
}
acquire_lock() {
  lock_command=$1
  lock_path_is_allowed || die "refusing unexpected lock path: $LOCK_DIR"
  mkdir -p "$(dirname "$LOCK_DIR")"
  [ ! -L "$LOCK_DIR" ] || die "operation lock must not be a symbolic link"
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    owner_pid=
    if [ -e "$LOCK_DIR/pid" ]; then
      [ -f "$LOCK_DIR/pid" ] && [ ! -L "$LOCK_DIR/pid" ] ||
        die "operation lock PID file is invalid"
      owner_pid=$(cat "$LOCK_DIR/pid")
    fi
    case "$owner_pid" in
      ''|*[!0-9]*) owner_pid= ;;
    esac
    if [ -n "$owner_pid" ] && kill -0 "$owner_pid" 2>/dev/null; then
      owner_command=unknown owner_started=unknown
      [ -f "$LOCK_DIR/command" ] && [ ! -L "$LOCK_DIR/command" ] &&
        owner_command=$(cat "$LOCK_DIR/command")
      [ -f "$LOCK_DIR/started" ] && [ ! -L "$LOCK_DIR/started" ] &&
        owner_started=$(cat "$LOCK_DIR/started")
      die "operation locked by PID $owner_pid: $owner_command since $owner_started"
    fi
    rm -f "$LOCK_DIR/pid" "$LOCK_DIR/command" "$LOCK_DIR/started"
    rmdir "$LOCK_DIR" 2>/dev/null ||
      die "operation lock is not a valid stale ProxyHub lock"
    mkdir "$LOCK_DIR" 2>/dev/null ||
      die "could not acquire operation lock"
  fi
  umask 077
  printf '%s\n' "$$" >"$LOCK_DIR/pid"
  printf '%s\n' "$lock_command" >"$LOCK_DIR/command"
  now >"$LOCK_DIR/started"
  chmod 600 "$LOCK_DIR/pid" "$LOCK_DIR/command" "$LOCK_DIR/started"
  LOCK_HELD=true
  trap 'release_lock' EXIT
  trap 'exit 1' HUP INT TERM
}
operation_content() {
  phase=$1 result=$2 rollback=${3:-none}
  cat <<EOF
schema=1
component=$OPERATION_COMPONENT
operation=$OPERATION_NAME
started_at=$OPERATION_STARTED
updated_at=$(now)
phase=$phase
result=$result
source_image=$OPERATION_SOURCE
target_image=$OPERATION_TARGET
source_asset_revision=$OPERATION_ASSET_SOURCE
target_asset_revision=$OPERATION_ASSET_TARGET
backup=$OPERATION_BACKUP
rollback=$rollback
failed_phase=$OPERATION_FAILED_PHASE
EOF
}
operation_begin() {
  OPERATION_COMPONENT=$1
  OPERATION_NAME=$2
  OPERATION_SOURCE=${3:-none}
  OPERATION_TARGET=${4:-none}
  OPERATION_BACKUP=${5:-none}
  OPERATION_PHASE=prepare
  OPERATION_FAILED_PHASE=none
  OPERATION_ASSET_SOURCE=none
  OPERATION_ASSET_TARGET=none
  OPERATION_STARTED=$(now)
  operation_dir="$STATE_DIR/operations"
  mkdir -p "$operation_dir"
  OPERATION_FILE="$operation_dir/$OPERATION_STARTED-$$-$OPERATION_COMPONENT-$OPERATION_NAME"
  atomic_write "$OPERATION_FILE" "$(operation_content prepare in_progress)"
}
operation_phase() {
  phase=$1
  OPERATION_PHASE=$phase
  [ -n "$OPERATION_FILE" ] || return 0
  atomic_write "$OPERATION_FILE" "$(operation_content "$phase" in_progress)"
}
operation_finish() {
  result=$1 rollback=${2:-none}
  [ -n "$OPERATION_FILE" ] || return 0
  atomic_write "$OPERATION_FILE" \
    "$(operation_content "$OPERATION_PHASE" "$result" "$rollback")"
}
write_component_state() {
  component=$1 image=$2 result=$3 backup=${4:-none}
  asset_revision=not_applicable
  [ "$component" != proxyhub ] ||
    asset_revision=$(current_asset_revision)
  atomic_write "$STATE_DIR/$component" "$(cat <<EOF
schema=1
component=$component
image=$image
asset_revision=$asset_revision
updated_at=$(now)
result=$result
backup=$backup
EOF
)"
}
proxyhub_health_payload() {
  port=$(sed -n 's/^PORT=//p' "$ENV_FILE" | tail -1)
  port=${port:-3000}
  wget -qO- "http://127.0.0.1:$port/healthz" 2>/dev/null
}
proxyhub_self_health() {
  attempts=${PROXYHUB_HEALTH_ATTEMPTS:-45}
  i=0
  while [ "$i" -lt "$attempts" ]; do
    payload=$(proxyhub_health_payload || true)
    if printf '%s\n' "$payload" |
      grep -Eq '"database"[[:space:]]*:[[:space:]]*"ok"'; then
      return 0
    fi
    i=$((i + 1)); sleep 2
  done
  return 1
}
dependency_health() {
  attempts=${PROXYHUB_HEALTH_ATTEMPTS:-45}
  i=0
  while [ "$i" -lt "$attempts" ]; do
    payload=$(proxyhub_health_payload || true)
    if printf '%s\n' "$payload" |
      grep -Eq '"reachable"[[:space:]]*:[[:space:]]*true'; then
      return 0
    fi
    i=$((i + 1)); sleep 2
  done
  return 1
}
substore_self_health() {
  attempts=${PROXYHUB_HEALTH_ATTEMPTS:-45}
  i=0
  while [ "$i" -lt "$attempts" ]; do
    if dc exec -T sub-store node -e "
      Promise.all([
        fetch('http://127.0.0.1:3000/api/utils/env'),
        fetch('http://127.0.0.1:3001/')
      ]).then(rs => process.exit(rs.every(r => r.ok) ? 0 : 1))
        .catch(() => process.exit(1))
    " >/dev/null 2>&1; then
      return 0
    fi
    i=$((i + 1)); sleep 2
  done
  return 1
}
component_self_health() {
  case "$1" in
    proxyhub) proxyhub_self_health ;;
    sub-store) substore_self_health ;;
    *) die "component must be proxyhub or sub-store" ;;
  esac
}
component_health() {
  component=$1
  component_self_health "$component" || return 1
  [ "$component" != proxyhub ] || dependency_health
}
health() { component_health proxyhub; }
validate_component() {
  case "${1:-}" in
    proxyhub|sub-store) ;;
    *) die "component must be proxyhub or sub-store" ;;
  esac
}
component_service() {
  validate_component "$1"
  echo "$1"
}
component_volume() {
  case "$1" in
    proxyhub) volume_name 1 ;;
    sub-store) volume_name 2 ;;
    *) die "component must be proxyhub or sub-store" ;;
  esac
}
component_archive_name() {
  case "$1" in
    proxyhub) echo proxyhub-data.tgz ;;
    sub-store) echo substore-data.tgz ;;
    *) die "component must be proxyhub or sub-store" ;;
  esac
}
component_env_key() {
  case "$1" in
    proxyhub) echo PROXYHUB_IMAGE ;;
    sub-store) echo SUBSTORE_IMAGE ;;
    *) die "component must be proxyhub or sub-store" ;;
  esac
}
component_default_image() {
  case "$1" in
    proxyhub) echo ghcr.io/miozen/proxyhub:dev ;;
    sub-store) echo xream/sub-store:2.36.21 ;;
    *) die "component must be proxyhub or sub-store" ;;
  esac
}
get_env() {
  key=$1 default=$2
  value=$(sed -n "s/^${key}=//p" "$ENV_FILE" | tail -1)
  printf '%s\n' "${value:-$default}"
}
volume_name() {
  case "$1" in
    1) echo proxyhub-data ;;
    2) echo proxyhub-substore-data ;;
    *) die "unknown volume index" ;;
  esac
}
archive_volume() {
  volume=$1 output=$2
  docker run --rm -v "$volume:/source:ro" -v "$(dirname "$output"):/backup" alpine:3.22 \
    sh -c "cd /source && tar czf /backup/$(basename "$output") ."
}
restore_volume() {
  volume=$1 input=$2
  docker run --rm -v "$volume:/target" -v "$(dirname "$input"):/backup:ro" alpine:3.22 \
    sh -c "find /target -mindepth 1 -maxdepth 1 -exec rm -rf {} + && tar xzf /backup/$(basename "$input") -C /target"
}
set_env() {
  key=$1 value=$2 tmp="$ENV_FILE.tmp"
  awk -v key="$key" -v value="$value" '
    BEGIN { found=0 } $0 ~ ("^" key "=") { print key "=" value; found=1; next }
    { print } END { if (!found) print key "=" value }
  ' "$ENV_FILE" >"$tmp"
  mv "$tmp" "$ENV_FILE"
}

download_file() {
  source_url=$1 output_file=$2
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 --connect-timeout 15 "$source_url" -o "$output_file"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$output_file" "$source_url"
  else
    die "curl or wget is required for deployment asset discovery"
  fi
}

manifest_value() {
  manifest_file=$1 manifest_key=$2
  value=$(sed -n \
    "s/.*\"$manifest_key\":[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" \
    "$manifest_file" | head -1)
  if [ -n "$value" ]; then
    printf '%s\n' "$value"
    return
  fi
  if grep -Eq "\"$manifest_key\":[[:space:]]*null" "$manifest_file"; then
    echo null
    return
  fi
  sed -n \
    "s/.*\"$manifest_key\":[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p" \
    "$manifest_file" | head -1
}

valid_release_version() {
  printf '%s\n' "${1#v}" |
    LC_ALL=C grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
}

version_compare() {
  left=${1#v} operator=$2 right=${3#v}
  valid_release_version "$left" && valid_release_version "$right" || return 2
  awk -v left="$left" -v right="$right" -v operator="$operator" '
    BEGIN {
      split(left, a, "."); split(right, b, ".")
      result=0
      for (i=1; i<=3; i++) {
        if ((a[i] + 0) > (b[i] + 0)) { result=1; break }
        if ((a[i] + 0) < (b[i] + 0)) { result=-1; break }
      }
      if (operator == "ge") exit(result >= 0 ? 0 : 1)
      if (operator == "lt") exit(result < 0 ? 0 : 1)
      exit 2
    }
  '
}

current_asset_revision() {
  if [ -f "$DEPLOY_DIR/compatibility.json" ]; then
    revision=$(manifest_value "$DEPLOY_DIR/compatibility.json" proxyhub_version)
    [ -n "$revision" ] && {
      printf '%s\n' "$revision"
      return
    }
  fi
  [ -f "$DEPLOY_DIR/VERSION" ] && cat "$DEPLOY_DIR/VERSION" || echo legacy
}

current_substore_version() {
  image=$(get_env SUBSTORE_IMAGE "")
  case "$image" in
    xream/sub-store:*) printf '%s\n' "${image#xream/sub-store:}" ;;
    *) echo unknown ;;
  esac
}

validate_compatibility_manifest() {
  manifest_file=$1 expected_version=$2
  [ "$(manifest_value "$manifest_file" schema)" = 1 ] ||
    die "unsupported deployment manifest schema"
  manifest_version=$(manifest_value "$manifest_file" proxyhub_version)
  [ "$manifest_version" = "$expected_version" ] ||
    die "deployment manifest version does not match $expected_version"
  manager_min=$(manifest_value "$manifest_file" manager_min_version)
  valid_release_version "$manager_min" ||
    die "invalid manager_min_version in deployment manifest"
  version_compare "$MANAGER_VERSION" ge "$manager_min" ||
    die "ProxyHub manager $manager_min or newer is required before this update"
  compose_revision=$(manifest_value "$manifest_file" compose_revision)
  environment_revision=$(manifest_value "$manifest_file" environment_revision)
  case "$compose_revision:$environment_revision" in
    *[!0-9:]*|:|*:|:*) die "invalid deployment asset revision" ;;
  esac

  substore_min=$(manifest_value "$manifest_file" substore_min_version)
  substore_max=$(manifest_value \
    "$manifest_file" substore_max_version_exclusive)
  [ -n "$substore_min" ] && [ -n "$substore_max" ] ||
    die "deployment manifest is missing Sub-Store compatibility fields"
  if [ "$substore_min" = null ] && [ "$substore_max" = null ]; then
    return
  fi
  substore_version=$(current_substore_version)
  if ! valid_release_version "$substore_version"; then
    die "cannot prove Sub-Store compatibility; run proxyhub update sub-store --version <compatible-version> first"
  fi
  if [ "$substore_min" != null ] &&
    ! version_compare "$substore_version" ge "$substore_min"; then
    die "Sub-Store $substore_min or newer is required; run proxyhub update sub-store --version $substore_min"
  fi
  if [ "$substore_max" != null ] &&
    ! version_compare "$substore_version" lt "$substore_max"; then
    die "Sub-Store must be older than $substore_max; select a compatible Sub-Store version explicitly"
  fi
}

validate_asset_directory() {
  asset_dir=$1 expected_version=$2
  [ -f "$asset_dir/compose.yaml" ] &&
    [ -f "$asset_dir/.env.example" ] &&
    [ -f "$asset_dir/proxyhub" ] &&
    [ -f "$asset_dir/VERSION" ] &&
    [ -f "$asset_dir/compatibility.json" ] ||
    die "deployment asset set is incomplete"
  [ "$(cat "$asset_dir/VERSION")" = "$expected_version" ] ||
    die "deployment VERSION does not match $expected_version"
  sh -n "$asset_dir/proxyhub" ||
    die "candidate ProxyHub manager has invalid shell syntax"
  validate_compatibility_manifest \
    "$asset_dir/compatibility.json" "$expected_version"
  docker compose \
    --project-directory "$DEPLOY_DIR" \
    --env-file "$ENV_FILE" \
    -f "$asset_dir/compose.yaml" \
    config --quiet ||
    die "candidate Compose configuration is invalid"
}

prepare_proxyhub_assets() {
  candidate=$1
  ASSET_STAGE=
  ASSET_TARGET_REVISION=none
  case "$candidate" in
    ghcr.io/miozen/proxyhub:v*) release_tag=${candidate##*:} ;;
    *) return 0 ;;
  esac
  release_version=${release_tag#v}
  valid_release_version "$release_version" ||
    die "invalid ProxyHub release version for deployment assets"
  mkdir -p "$STATE_DIR"
  ASSET_STAGE="$STATE_DIR/asset-stage-$$"
  [ ! -e "$ASSET_STAGE" ] ||
    die "deployment asset staging path already exists"
  mkdir "$ASSET_STAGE"
  archive_name=proxyhub-deploy-$release_version.tar.gz
  release_base=https://github.com/miozen/proxyhub/releases/download/$release_tag
  download_file "$release_base/$archive_name" "$ASSET_STAGE/$archive_name"
  download_file "$release_base/SHA256SUMS" "$ASSET_STAGE/SHA256SUMS"
  grep "[[:space:]]$archive_name\$" "$ASSET_STAGE/SHA256SUMS" \
    >"$ASSET_STAGE/archive.sha256" ||
    die "deployment archive checksum is missing"
  (
    cd "$ASSET_STAGE"
    sha256sum -c archive.sha256
  ) || die "deployment archive checksum failed"
  tar -tzf "$ASSET_STAGE/$archive_name" | sort >"$ASSET_STAGE/contents"
  printf '%s\n' \
    .env.example VERSION compatibility.json compose.yaml proxyhub |
    sort >"$ASSET_STAGE/expected"
  diff -u "$ASSET_STAGE/expected" "$ASSET_STAGE/contents" >/dev/null ||
    die "deployment archive contains unexpected files"
  mkdir "$ASSET_STAGE/candidate"
  tar -xzf "$ASSET_STAGE/$archive_name" -C "$ASSET_STAGE/candidate"
  validate_asset_directory "$ASSET_STAGE/candidate" "$release_version"
  ASSET_TARGET_REVISION=$release_version
}

prepare_proxyhub_assets_guarded() {
  candidate=$1
  ASSET_STAGE=
  ASSET_TARGET_REVISION=none
  case "$candidate" in
    ghcr.io/miozen/proxyhub:v*)
      release_tag=${candidate##*:}
      ASSET_STAGE="$STATE_DIR/asset-stage-$$"
      ASSET_TARGET_REVISION=${release_tag#v}
      ;;
  esac
  (
    trap - 0 HUP INT TERM
    prepare_proxyhub_assets "$candidate"
  )
}

switch_proxyhub_assets() {
  asset_dir=$1
  for asset_name in compose.yaml .env.example proxyhub VERSION \
    compatibility.json; do
    asset_mode=0644
    [ "$asset_name" = proxyhub ] && asset_mode=0755
    [ "$asset_name" = .env.example ] && asset_mode=0600
    asset_temp="$DEPLOY_DIR/.$asset_name.new.$$"
    install -m "$asset_mode" "$asset_dir/$asset_name" "$asset_temp" ||
      return 1
    mv "$asset_temp" "$DEPLOY_DIR/$asset_name" || return 1
  done
}

merge_environment_template() {
  template=$1
  environment_temp="$ENV_FILE.asset-update.$$"
  cp "$ENV_FILE" "$environment_temp" || {
    echo "could not stage the current environment" >&2
    return 1
  }
  while IFS= read -r template_line; do
    template_line=$(printf '%s' "$template_line" | sed 's/\r$//')
    case "$template_line" in ''|'#'*) continue ;; esac
    template_key=${template_line%%=*}
    case "$template_key" in
      ''|*[!A-Z0-9_]*)
        echo "invalid key in the candidate environment template" >&2
        rm -f "$environment_temp"
        return 1
        ;;
    esac
    if ! grep -q "^$template_key=" "$environment_temp"; then
      printf '%s\n' "$template_line" >>"$environment_temp" || {
        rm -f "$environment_temp"
        return 1
      }
    fi
  done <"$template"
  chmod 600 "$environment_temp" || {
    echo "could not protect the staged environment" >&2
    rm -f "$environment_temp"
    return 1
  }
  mv "$environment_temp" "$ENV_FILE" || {
    echo "could not atomically switch the environment" >&2
    rm -f "$environment_temp"
    return 1
  }
  return 0
}

backup_proxyhub_assets() {
  target=$1
  asset_copy="$target/.deployment-assets"
  mkdir "$asset_copy"
  for asset_name in compose.yaml .env.example proxyhub VERSION; do
    [ -f "$DEPLOY_DIR/$asset_name" ] ||
      die "current ProxyHub deployment asset is missing: $asset_name"
    cp -p "$DEPLOY_DIR/$asset_name" "$asset_copy/$asset_name"
  done
  if [ -f "$DEPLOY_DIR/compatibility.json" ]; then
    cp -p "$DEPLOY_DIR/compatibility.json" \
      "$asset_copy/compatibility.json"
  fi
  cp "$ENV_FILE" "$target/proxyhub.env"
  chmod 600 "$target/proxyhub.env"
  tar -czf "$target/deployment-assets.tgz" -C "$asset_copy" .
  rm -rf "$asset_copy"
}

restore_proxyhub_assets() {
  target=$1
  [ -f "$target/deployment-assets.tgz" ] || return 0
  restore_stage="$STATE_DIR/asset-stage-restore-$$"
  [ ! -e "$restore_stage" ] || return 1
  mkdir "$restore_stage"
  tar -tzf "$target/deployment-assets.tgz" |
    sed 's|^\./||' | sed '/^$/d' | sort >"$restore_stage/contents" ||
    return 1
  printf '%s\n' .env.example VERSION compose.yaml proxyhub |
    sort >"$restore_stage/legacy-expected"
  printf '%s\n' \
    .env.example VERSION compatibility.json compose.yaml proxyhub |
    sort >"$restore_stage/current-expected"
  if ! diff -u "$restore_stage/legacy-expected" \
      "$restore_stage/contents" >/dev/null &&
    ! diff -u "$restore_stage/current-expected" \
      "$restore_stage/contents" >/dev/null; then
    return 1
  fi
  tar -xzf "$target/deployment-assets.tgz" -C "$restore_stage" ||
    return 1
  for asset_name in compose.yaml .env.example proxyhub VERSION; do
    [ -f "$restore_stage/$asset_name" ] || return 1
  done
  sh -n "$restore_stage/proxyhub" || return 1
  docker compose \
    --project-directory "$DEPLOY_DIR" \
    --env-file "$ENV_FILE" \
    -f "$restore_stage/compose.yaml" \
    config --quiet || return 1
  if [ ! -f "$restore_stage/compatibility.json" ]; then
    cat >"$restore_stage/compatibility.json" <<EOF
{
  "schema": 1,
  "proxyhub_version": "$(cat "$restore_stage/VERSION")",
  "manager_min_version": "0.1.5",
  "compose_revision": 1,
  "environment_revision": 1,
  "substore_min_version": null,
  "substore_max_version_exclusive": null
}
EOF
  fi
  switch_proxyhub_assets "$restore_stage"
  restore_result=$?
  rm -rf "$restore_stage"
  return "$restore_result"
}

backup_path() {
  scope=$1 name=$2
  case "$scope" in
    all) printf '%s\n' "$FULL_BACKUP_DIR/$name" ;;
    proxyhub|sub-store)
      printf '%s\n' "$COMPONENT_BACKUP_DIR/$scope/$name"
      ;;
    *) die "backup scope must be all, proxyhub or sub-store" ;;
  esac
}
validate_backup_name() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) die "invalid backup name" ;;
  esac
}
backup_root_path() {
  mkdir -p "$BACKUP_DIR"
  (CDPATH= cd -- "$BACKUP_DIR" && pwd -P)
}
validated_backup_path() {
  target=$1
  [ -d "$target" ] || die "backup directory required"
  root=$(backup_root_path)
  resolved=$(CDPATH= cd -- "$target" && pwd -P)
  case "$resolved" in
    "$root"/*) printf '%s\n' "$resolved" ;;
    *) die "backup path must remain under $root" ;;
  esac
}
write_backup_metadata() {
  target=$1 type=$2 component=$3 created=$4
  atomic_write "$target/metadata" "$(cat <<EOF
schema=1
type=$type
component=$component
created_at=$created
EOF
)"
}
write_backup_checksums() {
  target=$1; shift
  (
    cd "$target"
    sha256sum "$@" >SHA256SUMS
  )
}
metadata_value() {
  target=$1 key=$2
  sed -n "s/^$key=//p" "$target/metadata" | tail -1
}
env_file_value() {
  file=$1 key=$2
  sed -n "s/^$key=//p" "$file" | tail -1
}
verify_backup_checksums() {
  target=$1
  [ -f "$target/SHA256SUMS" ] || die "backup checksum manifest is missing"
  (cd "$target" && sha256sum -c SHA256SUMS >/dev/null) ||
    die "backup checksum validation failed"
}
verify_component_backup() {
  component=$1 target=$2
  archive=$(component_archive_name "$component")
  [ -f "$target/metadata" ] && [ -f "$target/image" ] &&
    [ -f "$target/$archive" ] || die "invalid $component backup"
  [ "$(metadata_value "$target" schema)" = 1 ] ||
    die "unsupported backup schema"
  [ "$(metadata_value "$target" type)" = component ] ||
    die "backup is not component-scoped"
  [ "$(metadata_value "$target" component)" = "$component" ] ||
    die "backup component mismatch"
  image=$(cat "$target/image")
  validate_image "$component" "$image"
  verify_backup_checksums "$target"
}
verify_full_backup() {
  target=$1
  [ -f "$target/metadata" ] && [ -f "$target/env" ] &&
    [ -f "$target/proxyhub-data.tgz" ] &&
    [ -f "$target/substore-data.tgz" ] || die "invalid full backup"
  [ "$(metadata_value "$target" schema)" = 1 ] ||
    die "unsupported backup schema"
  [ "$(metadata_value "$target" type)" = full ] ||
    die "backup is not full"
  [ "$(metadata_value "$target" component)" = all ] ||
    die "full backup component mismatch"
  proxyhub_image=$(env_file_value "$target/env" PROXYHUB_IMAGE)
  substore_image=$(env_file_value "$target/env" SUBSTORE_IMAGE)
  validate_image proxyhub "$proxyhub_image"
  validate_image sub-store "$substore_image"
  verify_backup_checksums "$target"
}

install_cmd() {
  need docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"
  mkdir -p "$(dirname "$ENV_FILE")" "$BACKUP_DIR" "$STATE_DIR" "$LOG_DIR"
  if [ ! -f "$ENV_FILE" ]; then
    need openssl
    cp "$DEPLOY_DIR/.env.example" "$ENV_FILE"
    set_env SESSION_SECRET "$(openssl rand -hex 32)"
    set_env DATA_ENCRYPTION_KEY "$(openssl rand -hex 32)"
    set_env PROXYHUB_IMAGE "ghcr.io/miozen/proxyhub:dev"
    set_env AUTO_UPDATE_ENABLED "false"
    chmod 600 "$ENV_FILE"
  fi
  dc pull
  dc up -d
  health || { dc logs proxyhub; die "health check failed"; }
  echo "ProxyHub installed at http://127.0.0.1:$(sed -n 's/^PORT=//p' "$ENV_FILE" | tail -1)/proxyhub/"
}
full_backup_cmd() {
  name=$1
  created=$(now)
  target=$(backup_path all "$name")
  [ ! -e "$target" ] || die "backup already exists: $name"
  mkdir -p "$target"
  cp "$ENV_FILE" "$target/env"
  running=$(dc ps -q)
  [ -z "$running" ] || dc stop
  failed=false
  archive_volume "$(volume_name 1)" "$target/proxyhub-data.tgz" || failed=true
  archive_volume "$(volume_name 2)" "$target/substore-data.tgz" || failed=true
  if [ -n "$running" ]; then
    dc start
    health || failed=true
  fi
  [ "$failed" = false ] || die "backup failed"
  write_backup_metadata "$target" full all "$created"
  write_backup_checksums "$target" \
    metadata env proxyhub-data.tgz substore-data.tgz
  echo "$target"
}
backup_cmd() {
  ensure_env
  scope=${1:-all}
  case "$scope" in
    all|proxyhub|sub-store) shift || true ;;
    *) scope=all ;;
  esac
  name=${1:-"manual-$scope-$(now)"}
  [ "$#" -le 1 ] || die "backup accepts a scope and optional name"
  validate_backup_name "$name"
  target=$(backup_path "$scope" "$name")
  operation_begin "$scope" backup none none "$target"
  operation_phase backup
  case "$scope" in
    all)
      if backup_output=$(full_backup_cmd "$name"); then
        operation_finish success none
        echo "$backup_output"
      else
        OPERATION_FAILED_PHASE=backup
        operation_finish failed backup_failed
        return 1
      fi
      ;;
    proxyhub|sub-store)
      if backup_output=$(component_backup_cmd "$scope" "$name"); then
        operation_finish success none
        echo "$backup_output"
      else
        OPERATION_FAILED_PHASE=backup
        operation_finish failed backup_failed
        return 1
      fi
      ;;
  esac
}
full_restore_cmd() {
  target=$1
  verify_full_backup "$target" || return 1
  dc down || return 1
  restore_volume "$(volume_name 1)" "$target/proxyhub-data.tgz" || return 1
  restore_volume "$(volume_name 2)" "$target/substore-data.tgz" || return 1
  cp "$target/env" "$ENV_FILE" || return 1
  dc up -d || return 1
  health || return 1
  write_component_state proxyhub \
    "$(env_file_value "$target/env" PROXYHUB_IMAGE)" restored "$target" ||
    return 1
  write_component_state sub-store \
    "$(env_file_value "$target/env" SUBSTORE_IMAGE)" restored "$target" ||
    return 1
}
restore_cmd() {
  ensure_env
  target=$(validated_backup_path "${1:-}")
  [ "$#" -eq 1 ] || die "restore accepts one backup path"
  if [ -f "$target/metadata" ]; then
    case "$(metadata_value "$target" type):$(metadata_value "$target" component)" in
      full:all) restore_component=all ;;
      component:proxyhub) restore_component=proxyhub ;;
      component:sub-store) restore_component=sub-store ;;
      *) die "invalid backup metadata" ;;
    esac
    operation_begin "$restore_component" restore none none "$target"
    operation_phase restore
    if [ "$restore_component" = all ]; then
      if full_restore_cmd "$target"; then
        operation_finish success none
      else
        OPERATION_FAILED_PHASE=restore
        operation_finish failed restore_failed
        return 1
      fi
    elif component_restore_cmd "$restore_component" "$target"; then
      operation_finish success none
    else
      OPERATION_FAILED_PHASE=restore
      operation_finish failed restore_failed
      return 1
    fi
    return
  fi
  [ -f "$target/proxyhub-data.tgz" ] &&
    [ -f "$target/substore-data.tgz" ] &&
    [ -f "$target/env" ] || die "invalid legacy backup"
  operation_begin all restore none none "$target"
  operation_phase legacy_restore
  dc down
  restore_volume "$(volume_name 1)" "$target/proxyhub-data.tgz"
  restore_volume "$(volume_name 2)" "$target/substore-data.tgz"
  cp "$target/env" "$ENV_FILE"
  dc up -d
  if health; then
    write_component_state proxyhub \
      "$(env_file_value "$target/env" PROXYHUB_IMAGE)" restored "$target"
    write_component_state sub-store \
      "$(env_file_value "$target/env" SUBSTORE_IMAGE)" restored "$target"
    operation_finish success none
  else
    OPERATION_FAILED_PHASE=legacy_restore
    operation_finish failed restore_health_failed
    die "legacy restore health check failed"
  fi
}
component_backup_cmd() {
  component=$1 name=$2
  validate_component "$component"
  validate_backup_name "$name"
  created=$(now)
  target=$(backup_path "$component" "$name")
  [ ! -e "$target" ] || die "backup already exists: $name"
  mkdir -p "$target"
  key=$(component_env_key "$component")
  get_env "$key" "$(component_default_image "$component")" >"$target/image"
  if [ "$component" = proxyhub ] && [ "$INSTALLED_LAYOUT" = true ]; then
    backup_proxyhub_assets "$target"
  fi
  service=$(component_service "$component")
  running=$(dc ps -q "$service")
  [ -z "$running" ] || dc stop "$service"
  failed=false
  archive_volume "$(component_volume "$component")" \
    "$target/$(component_archive_name "$component")" || failed=true
  if [ -n "$running" ]; then
    dc start "$service" || failed=true
    component_health "$component" || failed=true
  fi
  [ "$failed" = false ] || die "$component backup failed"
  write_backup_metadata "$target" component "$component" "$created"
  if [ "$component" = proxyhub ] &&
    [ -f "$target/deployment-assets.tgz" ]; then
    printf '%s\n' "asset_revision=$(current_asset_revision)" \
      >>"$target/metadata"
    write_backup_checksums "$target" metadata image proxyhub.env \
      "$(component_archive_name "$component")" deployment-assets.tgz
  else
    write_backup_checksums "$target" \
      metadata image "$(component_archive_name "$component")"
  fi
  case "$name" in
    pre-update-"$component"-*) prune_automatic_backups "$component" ;;
  esac
  echo "$target"
}
prune_automatic_backups() {
  component=$1
  validate_component "$component"
  mkdir -p "$STATE_DIR"
  list="$STATE_DIR/.automatic-backups-$component"
  component_dir="$COMPONENT_BACKUP_DIR/$component"
  mkdir -p "$component_dir"
  find "$component_dir" -mindepth 1 -maxdepth 1 -type d \
    -name "pre-update-$component-*" -print |
    sort -r >"$list"
  retained=0
  while IFS= read -r backup; do
    [ -n "$backup" ] || continue
    retained=$((retained + 1))
    [ "$retained" -le 5 ] && continue
    case "$backup" in
      "$component_dir"/pre-update-"$component"-*) rm -rf "$backup" ;;
      *) rm -f "$list"; die "refusing to prune unexpected backup path" ;;
    esac
  done <"$list"
  rm -f "$list"
}
component_restore_cmd() {
  component=$1 target=$2
  validate_component "$component"
  target=$(validated_backup_path "$target")
  verify_component_backup "$component" "$target" || return 1
  archive="$target/$(component_archive_name "$component")"
  service=$(component_service "$component")
  key=$(component_env_key "$component")
  dc stop "$service" || return 1
  restore_volume "$(component_volume "$component")" "$archive" || return 1
  if [ "$component" = proxyhub ] && [ -f "$target/proxyhub.env" ]; then
    restore_env_temp="$ENV_FILE.restore.$$"
    cp "$target/proxyhub.env" "$restore_env_temp" || return 1
    chmod 600 "$restore_env_temp" || return 1
    mv "$restore_env_temp" "$ENV_FILE" || return 1
  fi
  set_env "$key" "$(cat "$target/image")" || return 1
  if [ "$component" = proxyhub ]; then
    restore_proxyhub_assets "$target" || return 1
  fi
  dc up -d --no-deps "$service" || return 1
  component_health "$component" || return 1
  write_component_state "$component" \
    "$(cat "$target/image")" restored "$target" || return 1
}
validate_image() {
  component=$1 image=$2
  case "$image" in *[!A-Za-z0-9_./:@-]*) die "invalid image reference" ;; esac
  case "$component:$image" in
    proxyhub:ghcr.io/miozen/proxyhub:*|proxyhub:ghcr.io/miozen/proxyhub@sha256:*|\
    proxyhub:ghcr.io/vonzhen/proxyhub:*|proxyhub:ghcr.io/vonzhen/proxyhub@sha256:*) ;;
    sub-store:xream/sub-store:*|sub-store:xream/sub-store@sha256:*) ;;
    *) die "image repository is not approved for $component" ;;
  esac
}

latest_proxyhub_tag() {
  if command -v curl >/dev/null 2>&1; then
    metadata=$(curl -fsSL --connect-timeout 15 \
      https://api.github.com/repos/miozen/proxyhub/releases/latest)
  elif command -v wget >/dev/null 2>&1; then
    metadata=$(wget -qO- \
      https://api.github.com/repos/miozen/proxyhub/releases/latest)
  else
    die "curl or wget is required for version discovery"
  fi
  tag=$(printf '%s\n' "$metadata" |
    sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' |
    head -1)
  [ -n "$tag" ] || die "no stable ProxyHub release is available"
  printf '%s\n' "$tag"
}

candidate_tag() {
  component=$1 version=$2 image=$3
  if [ -n "$image" ]; then
    validate_image "$component" "$image"
    printf '%s\n' "$image"
    return
  fi
  if [ "$component" = proxyhub ]; then
    if [ -n "$version" ]; then
      case "$version" in v*) tag=$version ;; *) tag=v$version ;; esac
    else
      tag=$(latest_proxyhub_tag)
    fi
    image=ghcr.io/miozen/proxyhub:$tag
  else
    tag=${version:-latest}
    image=xream/sub-store:$tag
  fi
  validate_image "$component" "$image"
  printf '%s\n' "$image"
}

resolve_image_digest() {
  component=$1 image=$2
  validate_image "$component" "$image"
  docker pull "$image" >&2
  case "$component" in
    proxyhub)
      case "$image" in
        ghcr.io/vonzhen/proxyhub:*) repository=ghcr.io/vonzhen/proxyhub ;;
        *) repository=ghcr.io/miozen/proxyhub ;;
      esac
      ;;
    sub-store) repository=xream/sub-store ;;
  esac
  digest=$(docker image inspect "$image" \
    --format '{{range .RepoDigests}}{{println .}}{{end}}' |
    sed -n "\|^${repository}@sha256:|p" |
    head -1)
  [ -n "$digest" ] || die "could not resolve immutable digest for $image"
  case "$(uname -m)" in
    x86_64|amd64) host_arch=amd64 ;;
    aarch64|arm64) host_arch=arm64 ;;
    *) die "unsupported host architecture" ;;
  esac
  image_os=$(docker image inspect "$image" --format '{{.Os}}')
  image_arch=$(docker image inspect "$image" --format '{{.Architecture}}')
  [ "$image_os" = linux ] && [ "$image_arch" = "$host_arch" ] ||
    die "$image does not support linux/$host_arch"
  printf '%s\n' "$digest"
}


current_image_matches_target() {
  component=$1 current=$2 target=$3
  [ "$current" = "$target" ] && return 0
  container_id=$(dc ps -q "$(component_service "$component")")
  [ -n "$container_id" ] || return 1
  current_image_id=$(docker inspect "$container_id" --format '{{.Image}}')
  target_image_id=$(docker image inspect "$target" --format '{{.Id}}')
  [ -n "$current_image_id" ] &&
    [ -n "$target_image_id" ] &&
    [ "$current_image_id" = "$target_image_id" ]
}

confirm_update() {
  component=$1 current=$2 target=$3 assume_yes=$4
  echo "Component: $component"
  echo "Current:   $current"
  echo "Target:    $target"
  [ "$assume_yes" = true ] && return
  [ -t 0 ] || die "confirmation required; rerun with --yes"
  printf 'Continue with backup and update? [y/N] '
  read -r answer
  case "$answer" in y|Y|yes|YES) ;; *) die "update cancelled" ;; esac
}

perform_update() {
  component=$1 image=$2 candidate=${3:-$2}
  current=$(get_env "$(component_env_key "$component")" \
    "$(component_default_image "$component")")
  operation_begin "$component" update "$current" "$image"
  if [ "$component" = proxyhub ]; then
    OPERATION_ASSET_SOURCE=$(current_asset_revision)
    operation_phase asset_stage
    if ! prepare_proxyhub_assets_guarded "$candidate"; then
      OPERATION_FAILED_PHASE=asset_stage
      operation_finish failed assets_rejected
      return 1
    fi
    OPERATION_ASSET_TARGET=$ASSET_TARGET_REVISION
  fi
  operation_phase backup
  if ! snapshot=$(component_backup_cmd "$component" "pre-update-$component-$(now)"); then
    OPERATION_FAILED_PHASE=backup
    operation_finish failed backup_failed
    return 1
  fi
  OPERATION_BACKUP=$snapshot
  mkdir -p "$STATE_DIR"
  atomic_write "$STATE_DIR/$component-last-backup" "$snapshot"
  operation_phase apply
  if [ "$component" = proxyhub ] && [ -n "$ASSET_STAGE" ]; then
    if ! switch_proxyhub_assets "$ASSET_STAGE/candidate"; then
      echo "ProxyHub asset switch failed; rolling back" >&2
      OPERATION_FAILED_PHASE=asset_apply
      operation_phase rollback
      if component_restore_cmd proxyhub "$snapshot"; then
        operation_finish failed rolled_back
      else
        operation_finish failed rollback_failed
      fi
      return 1
    fi
    if ! merge_environment_template \
      "$ASSET_STAGE/candidate/.env.example"; then
      echo "ProxyHub environment schema update failed; rolling back" >&2
      OPERATION_FAILED_PHASE=environment_schema
      operation_phase rollback
      if component_restore_cmd proxyhub "$snapshot"; then
        operation_finish failed rolled_back
      else
        operation_finish failed rollback_failed
      fi
      return 1
    fi
  fi
  if ! set_env "$(component_env_key "$component")" "$image"; then
    echo "$component environment update failed; rolling back" >&2
    OPERATION_FAILED_PHASE=environment_apply
    operation_phase rollback
    if component_restore_cmd "$component" "$snapshot"; then
      operation_finish failed rolled_back
    else
      operation_finish failed rollback_failed
    fi
    return 1
  fi
  update_failed=false
  if [ "$component" = proxyhub ]; then
    dc pull proxyhub &&
      dc up -d --no-deps proxyhub &&
      component_health proxyhub || update_failed=true
  else
    dc pull sub-store &&
      dc up -d --no-deps sub-store &&
      component_health sub-store || update_failed=true
  fi
  if [ "$update_failed" = true ]; then
    echo "$component update failed; rolling back" >&2
    OPERATION_FAILED_PHASE=apply
    operation_phase rollback
    if component_restore_cmd "$component" "$snapshot"; then
      operation_finish failed rolled_back
    else
      operation_finish failed rollback_failed
    fi
    return 1
  fi
  write_component_state "$component" "$image" updated "$snapshot"
  operation_finish success none
  echo "$component update successful. Rollback point: $snapshot"
}

legacy_update_cmd() {
  proxy_image= substore_image= confirm=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --proxyhub-image) proxy_image=${2:-}; shift 2 ;;
      --substore-image) substore_image=${2:-}; shift 2 ;;
      --confirm-substore) confirm=true; shift ;;
      *) die "unknown legacy update option: $1" ;;
    esac
  done
  [ -n "$proxy_image$substore_image" ] || die "an image option is required"
  [ -z "$proxy_image" ] || [ -z "$substore_image" ] ||
    die "update one component at a time"
  if [ -n "$proxy_image" ]; then
    component=proxyhub; image=$proxy_image
  else
    component=sub-store; image=$substore_image
    [ "$confirm" = true ] ||
      die "Sub-Store update requires --confirm-substore"
  fi
  validate_image "$component" "$image"
  target=$(resolve_image_digest "$component" "$image")
  current=$(get_env "$(component_env_key "$component")" \
    "$(component_default_image "$component")")
  if current_image_matches_target "$component" "$current" "$target"; then
    echo "$component is already current: $target"
    return
  fi
  perform_update "$component" "$target" "$image"
}

update_cmd() {
  ensure_env
  case "${1:-}" in
    --*) legacy_update_cmd "$@"; return ;;
  esac
  component=${1:-}; shift || true
  validate_component "$component"
  version= image= assume_yes=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --version) version=${2:-}; shift 2 ;;
      --image) image=${2:-}; shift 2 ;;
      --yes) assume_yes=true; shift ;;
      *) die "unknown update option: $1" ;;
    esac
  done
  [ -z "$version" ] || [ -z "$image" ] ||
    die "use either --version or --image"
  candidate=$(candidate_tag "$component" "$version" "$image")
  target=$(resolve_image_digest "$component" "$candidate")
  current=$(get_env "$(component_env_key "$component")" \
    "$(component_default_image "$component")")
  echo "Candidate: $candidate"
  echo "Resolved:  $target"
  asset_update_required=false
  if [ "$component" = proxyhub ]; then
    case "$candidate" in
      ghcr.io/miozen/proxyhub:v*)
        candidate_revision=${candidate##*:}
        candidate_revision=${candidate_revision#v}
        [ "$(current_asset_revision)" = "$candidate_revision" ] ||
          asset_update_required=true
        ;;
    esac
  fi
  if current_image_matches_target "$component" "$current" "$target" &&
    [ "$asset_update_required" = false ]; then
    echo "$component is already current: $target"
    return
  fi
  confirm_update "$component" "$current" "$target" "$assume_yes"
  perform_update "$component" "$target" "$candidate"
}
rollback_cmd() {
  component=${1:-}
  validate_component "$component"
  state="$STATE_DIR/$component-last-backup"
  [ -f "$state" ] || die "no $component rollback point"
  target=$(cat "$state")
  current=$(get_env "$(component_env_key "$component")" \
    "$(component_default_image "$component")")
  operation_begin "$component" rollback "$current" unknown "$target"
  operation_phase restore
  if component_restore_cmd "$component" "$target"; then
    OPERATION_TARGET=$(get_env "$(component_env_key "$component")" unknown)
    operation_finish success none
  else
    OPERATION_FAILED_PHASE=restore
    operation_finish failed restore_failed
    return 1
  fi
}
check_updates_cmd() {
  ensure_env
  requested=${1:-}
  [ "$#" -le 1 ] || die "check-updates accepts at most one component"
  [ -z "$requested" ] || validate_component "$requested"
  failed=false
  for component in proxyhub sub-store; do
    [ -z "$requested" ] || [ "$requested" = "$component" ] || continue
    if candidate=$(candidate_tag "$component" "" "") &&
      target=$(resolve_image_digest "$component" "$candidate"); then
      current=$(get_env "$(component_env_key "$component")" \
        "$(component_default_image "$component")")
      echo "$component current: $current"
      echo "$component tag:     $candidate"
      echo "$component latest:  $target"
    else
      echo "$component update check failed" >&2
      failed=true
    fi
  done
  [ "$failed" = false ]
}
uninstall_cmd() {
  [ "$#" -eq 0 ] || die "uninstall accepts no options"
  if [ "$INSTALLED_LAYOUT" = true ]; then
    [ "$DEPLOY_DIR" = /opt/proxyhub ] ||
      die "refusing uninstall: unexpected deployment path"
    [ "$ENV_FILE" = /etc/proxyhub/proxyhub.env ] ||
      die "refusing uninstall: unexpected configuration path"
    [ "$DATA_DIR" = /var/lib/proxyhub ] ||
      die "refusing uninstall: unexpected data path"
    [ "$LOG_DIR" = /var/log/proxyhub ] ||
      die "refusing uninstall: unexpected log path"
    [ "$COMPOSE_FILE" = /opt/proxyhub/compose.yaml ] ||
      die "refusing uninstall: unexpected Compose path"
  fi
  echo "Permanent deletion targets:"
  echo "  $DEPLOY_DIR"
  echo "  $ENV_FILE"
  echo "  $DATA_DIR"
  echo "  $LOG_DIR"
  echo "  Docker volumes: proxyhub-data, proxyhub-substore-data"
  if [ "${PROXYHUB_UNINSTALL_CONFIRM:-}" != "DELETE" ]; then
    [ -t 0 ] ||
      die "set PROXYHUB_UNINSTALL_CONFIRM=DELETE to uninstall"
    printf 'Type DELETE to continue: '
    read -r answer
    [ "$answer" = "DELETE" ] || die "uninstall cancelled"
  fi
  dc down --volumes --remove-orphans
  if [ "$INSTALLED_LAYOUT" = true ]; then
    if [ -L /usr/local/bin/proxyhub ] &&
      [ "$(readlink /usr/local/bin/proxyhub)" = "$DEPLOY_DIR/proxyhub" ]; then
      rm -f /usr/local/bin/proxyhub
    fi
    rm -rf /opt/proxyhub /etc/proxyhub /var/lib/proxyhub /var/log/proxyhub
  else
    rm -f "$ENV_FILE"
  fi
  echo "ProxyHub and Sub-Store data were permanently deleted. Docker was retained."
}
lifecycle_cmd() {
  action=$1; shift
  component=${1:-}
  if [ -z "$component" ]; then
    case "$action" in
      start) dc up -d ;;
      stop|restart) dc "$action" ;;
      status) dc ps ;;
    esac
    return
  fi
  [ "$#" -eq 1 ] || die "$action accepts at most one component"
  validate_component "$component"
  case "$action" in
    start) dc up -d --no-deps "$component" ;;
    stop|restart) dc "$action" "$component" ;;
    status) dc ps "$component" ;;
  esac
}
component_health_report() {
  component=$1
  container=stopped self=unhealthy dependency=not_applicable overall=unhealthy
  [ -n "$(dc ps -q "$component")" ] && container=running
  previous_attempts=${PROXYHUB_HEALTH_ATTEMPTS:-}
  PROXYHUB_HEALTH_ATTEMPTS=1
  if [ "$container" = running ] && component_self_health "$component"; then
    self=healthy
  fi
  if [ "$component" = proxyhub ]; then
    dependency=unhealthy
    if [ "$container" = running ] && dependency_health; then
      dependency=healthy
    fi
  fi
  PROXYHUB_HEALTH_ATTEMPTS=$previous_attempts
  if [ "$container" = running ] && [ "$self" = healthy ] &&
    { [ "$component" != proxyhub ] || [ "$dependency" = healthy ]; }; then
    overall=healthy
  fi
  echo "$component container=$container self=$self dependency=$dependency overall=$overall"
}
status_cmd() {
  requested=${1:-all}
  [ "$#" -le 1 ] || die "status accepts at most one scope"
  case "$requested" in
    all)
      dc ps
      component_health_report proxyhub
      component_health_report sub-store
      ;;
    proxyhub|sub-store)
      dc ps "$requested"
      component_health_report "$requested"
      ;;
    *) die "scope must be all, proxyhub or sub-store" ;;
  esac
}
logs_cmd() {
  component=${1:-}
  case "$component" in
    proxyhub|sub-store) shift; dc logs "$@" "$component" ;;
    ''|-*) dc logs "$@" ;;
    *) die "component must be proxyhub or sub-store" ;;
  esac
}

doctor_cmd() {
  ensure_env
  failed=false
  echo "ProxyHub diagnostics"
  if command -v docker >/dev/null 2>&1 &&
    docker info >/dev/null 2>&1; then
    echo "[OK] Docker daemon is available"
  else
    echo "[FAIL] Docker daemon is unavailable"
    failed=true
  fi
  if docker compose version >/dev/null 2>&1 &&
    dc config --quiet >/dev/null 2>&1; then
    echo "[OK] Compose configuration is valid"
  else
    echo "[FAIL] Compose configuration is invalid"
    failed=true
  fi
  if [ -d "$STATE_DIR" ] && [ ! -L "$STATE_DIR" ]; then
    echo "[OK] state directory is available"
  else
    echo "[FAIL] state directory is unavailable"
    failed=true
  fi
  if [ -d "$LOCK_DIR" ]; then
    echo "[WARN] a lifecycle operation lock is present"
  else
    echo "[OK] no lifecycle operation lock is present"
  fi
  component_health_report proxyhub || failed=true
  component_health_report sub-store || failed=true
  [ "$failed" = false ]
}

print_help() {
  cat <<'EOF'
Usage: proxyhub [menu]
       proxyhub {status|start|stop|restart} [all|proxyhub|sub-store]
       proxyhub logs [all|proxyhub|sub-store] [--tail=N] [-f]
       proxyhub check-updates [all|proxyhub|sub-store]
       proxyhub update <proxyhub|sub-store> [--version X|--image I] [--yes]
       proxyhub rollback <proxyhub|sub-store>
       proxyhub backup [all|proxyhub|sub-store] [name]
       proxyhub restore <backup-path>
       proxyhub doctor
       proxyhub uninstall
EOF
}

menu_require_tty() {
  [ -t 0 ] && [ -t 1 ] ||
    die "menu requires an interactive terminal; run proxyhub help"
}

menu_read() {
  menu_prompt=$1
  printf '%s' "$menu_prompt"
  IFS= read -r MENU_REPLY || return 1
}

menu_pause() {
  menu_read "Press Enter to continue..." || return 1
}

menu_safe_text() {
  case "$1" in
    ''|*[!A-Za-z0-9_./:@-]*) return 1 ;;
    *) return 0 ;;
  esac
}

menu_command() {
  printf '\nCommand: proxyhub'
  for menu_arg in "$@"; do
    printf ' %s' "$menu_arg"
  done
  printf '\n\n'
  "$SCRIPT" "$@" || {
    menu_status=$?
    echo "Command failed with exit code $menu_status."
    return "$menu_status"
  }
}

menu_component_row() {
  menu_component=$1
  if [ -n "$(dc ps -q "$menu_component")" ]; then
    menu_state=running
  else
    menu_state=stopped
  fi
  menu_image=$(get_env "$(component_env_key "$menu_component")" unknown)
  printf '%-14s %-10s %-48s %s\n' \
    "$menu_component" "$menu_state" "$menu_image" "not checked"
}

component_menu() {
  menu_component=$1
  while :; do
    echo
    echo "$menu_component management"
    echo "1. Status"
    echo "2. Check update"
    echo "3. Update latest stable"
    echo "4. Update selected version"
    echo "5. Rollback last update"
    echo "6. Start"
    echo "7. Stop"
    echo "8. Restart"
    echo "9. Logs (last 100 lines)"
    echo "10. Manual component backup"
    echo "0. Back"
    menu_read "Select: " || return 0
    case "$MENU_REPLY" in
      1) menu_command status "$menu_component"; menu_pause || return 0 ;;
      2) menu_command check-updates "$menu_component"; menu_pause || return 0 ;;
      3) menu_command update "$menu_component"; menu_pause || return 0 ;;
      4)
        menu_read "Version: " || return 0
        menu_safe_text "$MENU_REPLY" || {
          echo "Invalid version; no action was run."
          continue
        }
        menu_version=$MENU_REPLY
        menu_command update "$menu_component" --version "$menu_version"
        menu_pause || return 0
        ;;
      5) menu_command rollback "$menu_component"; menu_pause || return 0 ;;
      6) menu_command start "$menu_component"; menu_pause || return 0 ;;
      7) menu_command stop "$menu_component"; menu_pause || return 0 ;;
      8) menu_command restart "$menu_component"; menu_pause || return 0 ;;
      9)
        menu_command logs "$menu_component" --tail=100
        menu_pause || return 0
        ;;
      10)
        menu_command backup "$menu_component"
        menu_pause || return 0
        ;;
      0) return 0 ;;
      *) echo "Invalid selection; no action was run." ;;
    esac
  done
}

backup_menu() {
  while :; do
    echo
    echo "Backup and restore"
    echo "1. Backup all components"
    echo "2. Backup ProxyHub"
    echo "3. Backup Sub-Store"
    echo "4. Restore a managed backup path"
    echo "0. Back"
    menu_read "Select: " || return 0
    case "$MENU_REPLY" in
      1) menu_command backup all; menu_pause || return 0 ;;
      2) menu_command backup proxyhub; menu_pause || return 0 ;;
      3) menu_command backup sub-store; menu_pause || return 0 ;;
      4)
        menu_read "Managed backup path: " || return 0
        menu_safe_text "$MENU_REPLY" || {
          echo "Invalid backup path; no action was run."
          continue
        }
        menu_backup_path=$MENU_REPLY
        menu_read "Run restore? [y/N] " || return 0
        case "$MENU_REPLY" in
          y|Y|yes|YES)
            menu_command restore "$menu_backup_path"
            menu_pause || return 0
            ;;
          *) echo "Restore cancelled." ;;
        esac
        ;;
      0) return 0 ;;
      *) echo "Invalid selection; no action was run." ;;
    esac
  done
}

logs_menu() {
  echo
  echo "Logs"
  echo "1. All components"
  echo "2. ProxyHub"
  echo "3. Sub-Store"
  echo "0. Back"
  menu_read "Select: " || return 0
  case "$MENU_REPLY" in
    1) menu_command logs --tail=100 ;;
    2) menu_command logs proxyhub --tail=100 ;;
    3) menu_command logs sub-store --tail=100 ;;
    0) return 0 ;;
    *) echo "Invalid selection; no action was run." ;;
  esac
  menu_pause || return 0
}

management_menu() {
  # Output is always plain text, so NO_COLOR and non-ANSI terminals need no
  # alternate rendering path.
  : "${NO_COLOR:=}"
  menu_require_tty
  ensure_env
  trap 'printf "\n"; exit 0' HUP INT TERM
  while :; do
    echo
    echo "ProxyHub management"
    echo
    printf '%-14s %-10s %-48s %s\n' \
      "Component" "State" "Version / image" "Update"
    menu_component_row proxyhub
    menu_component_row sub-store
    echo
    echo "1. ProxyHub"
    echo "2. Sub-Store"
    echo "3. Check updates"
    echo "4. Backup and restore"
    echo "5. Logs"
    echo "6. Diagnostics"
    echo "0. Exit"
    menu_read "Select: " || return 0
    case "$MENU_REPLY" in
      1) component_menu proxyhub ;;
      2) component_menu sub-store ;;
      3) menu_command check-updates; menu_pause || return 0 ;;
      4) backup_menu ;;
      5) logs_menu ;;
      6) menu_command doctor; menu_pause || return 0 ;;
      0) return 0 ;;
      *) echo "Invalid selection; no action was run." ;;
    esac
  done
}

if [ "$#" -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    management_menu
  else
    print_help
  fi
  exit 0
fi

command=$1; shift
case "$command" in
  menu) [ "$#" -eq 0 ] || die "menu accepts no options"; management_menu ;;
  install) acquire_lock install; install_cmd "$@" ;;
  start|stop|restart)
    ensure_env; acquire_lock "$command ${1:-all}"; lifecycle_cmd "$command" "$@"
    ;;
  status) ensure_env; status_cmd "$@" ;;
  logs) ensure_env; logs_cmd "$@" ;;
  backup) ensure_env; acquire_lock "backup ${1:-all}"; backup_cmd "$@" ;;
  restore) ensure_env; acquire_lock restore; restore_cmd "$@" ;;
  update) ensure_env; acquire_lock "update ${1:-}"; update_cmd "$@" ;;
  check-updates) check_updates_cmd "$@" ;;
  rollback) ensure_env; acquire_lock "rollback ${1:-}"; rollback_cmd "$@" ;;
  doctor) [ "$#" -eq 0 ] || die "doctor accepts no options"; doctor_cmd ;;
  uninstall) acquire_lock uninstall; uninstall_cmd "$@" ;;
  help|-h|--help) print_help ;;
  *) die "unknown command: $command" ;;
esac
